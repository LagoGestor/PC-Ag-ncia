// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tarefa {
  id           String   @id @default(cuid())
  tarefa       String
  area         String
  tipo         String   @default("")
  responsavel  String
  descricao    String   @default("")
  link         String   @default("")
  solicitacao  String   @default("")
  feedback     String   @default("")
  entrega      String   @default("")
  horarioPublicacao String @default("")
  status       String   @default("Ativa")
  arquivada    Boolean  @default(false)
  fixa         Boolean  @default(false)
  diaSemana    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Reuniao {
  id            String    @id @default(cuid())
  data          String    @default("")
  participantes String    @default("")
  modalidade    String    @default("Presencial")
  assuntos      Assunto[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Assunto {
  id             String   @id @default(cuid())
  reuniaoId      String
  reuniao        Reuniao  @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  tema           String   @default("")
  descricao      String   @default("")
  encaminhamento String   @default("")
  responsavel    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum NivelAcesso {
  MASTER
  DIRETOR_CONTEUDO
  EXECUTOR
}

model Usuario {
  id          String      @id @default(cuid())
  nome        String      @default("")
  foto        String      @default("")
  login       String      @unique
  senhaHash   String
  nivel       NivelAcesso
  responsavel String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
