// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tarefa {
  id           String   @id @default(cuid())
  tarefa       String
  area         String
  tipo         String   @default("")
  responsavel  String
  descricao    String   @default("")
  link         String   @default("")
  solicitacao  String   @default("")
  feedback     String   @default("")
  entrega      String   @default("")
  horarioPublicacao String @default("")
  status       String   @default("Ativa")
  arquivada    Boolean  @default(false)
  fixa         Boolean  @default(false)
  diaSemana    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Reuniao {
  id            String    @id @default(cuid())
  data          String    @default("")
  participantes String    @default("")
  modalidade    String    @default("Presencial")
  assuntos      Assunto[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Assunto {
  id             String   @id @default(cuid())
  reuniaoId      String
  reuniao        Reuniao  @relation(fields: [reuniaoId], references: [id], onDelete: Cascade)
  tema           String   @default("")
  descricao      String   @default("")
  encaminhamento String   @default("")
  responsavel    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum NivelAcesso {
  MASTER
  DIRETOR_CONTEUDO
  EXECUTOR
}

model Usuario {
  id          String      @id @default(cuid())
  nome        String      @default("")
  foto        String      @default("")
  login       String      @unique
  senhaHash   String
  nivel       NivelAcesso
  responsavel String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum RedeSocial {
  INSTAGRAM
  YOUTUBE
}

// Guarda o token de acesso de cada rede conectada (uma linha por rede).
model IntegracaoSocial {
  id             String     @id @default(cuid())
  rede           RedeSocial @unique
  accessToken    String     @default("")
  refreshToken   String     @default("")
  expiraEm       DateTime?
  contaId        String     @default("")
  contaNome      String     @default("")
  conectadoPor   String     @default("")
  conectadoEm    DateTime   @default(now())
  atualizadoEm   DateTime   @updatedAt
}

// Um "retrato" da semana (segunda a domingo). Uma linha por semana — a base de tudo:
// sem isso guardado toda semana, comparativos e visão mensal ficam impossíveis de reconstruir depois,
// já que o Instagram não permite consultar retroativamente tudo que já aconteceu.
model SnapshotSemanal {
  id                    String   @id @default(cuid())
  inicioSemana          String   @unique // YYYY-MM-DD (segunda-feira)
  fimSemana             String   // YYYY-MM-DD (domingo)
  origemDados           String   @default("manual") // "manual" | "api"

  // Instagram — feed/reels
  igSeguidores          Int      @default(0)
  igSeguidoresGanhos    Int      @default(0)
  igContasAlcancadas    Int      @default(0)
  igImpressoes          Int      @default(0)
  igVisualizacoes       Int      @default(0)
  igCurtidas            Int      @default(0)
  igComentarios         Int      @default(0)
  igCompartilhamentos   Int      @default(0)
  igSalvamentos         Int      @default(0)

  // Instagram — stories (seção própria: métricas e janela de captura diferentes do feed)
  igStoriesPublicados   Int      @default(0)
  igStoriesAlcance      Int      @default(0)
  igStoriesImpressoes   Int      @default(0)
  igStoriesRespostas    Int      @default(0)
  igStoriesSaidas       Int      @default(0)
  igStoriesAvancos      Int      @default(0)
  igStoriesVoltas       Int      @default(0)

  // YouTube
  ytInscritos           Int      @default(0)
  ytInscritosGanhos     Int      @default(0)
  ytVisualizacoes       Int      @default(0)
  ytImpressoes          Int      @default(0)
  ytCtr                 Float    @default(0)
  ytTempoExibicaoMin    Int      @default(0)
  ytDuracaoMediaSeg     Int      @default(0)

  // Análise gerada (IA) a partir dos números desta semana comparados à anterior.
  diagnostico           String   @default("")
  recomendacoes         String   @default("")

  posts                 PostSemanal[]

  criadoEm              DateTime @default(now())
}

model PostSemanal {
  id                String          @id @default(cuid())
  snapshotId        String
  snapshot          SnapshotSemanal @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  rede              RedeSocial
  tipo              String          @default("") // Reels, Carrossel, Post, Vídeo, Story...
  titulo            String          @default("")
  link              String          @default("")
  publicadoEm       String          @default("")
  alcance           Int             @default(0)
  visualizacoes     Int             @default(0)
  curtidas          Int             @default(0)
  comentarios       Int             @default(0)
  compartilhamentos Int             @default(0)
  salvamentos       Int             @default(0)
  taxaEngajamento   Float           @default(0)
}
